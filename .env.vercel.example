# Add these in Vercel: Project > Settings > Environment Variables (Production).
# vercel.json already sets APP_ENV, APP_DEBUG, cache/session/log settings and FILESYSTEM_DISK=s3.

APP_NAME="MedTech Distributions"
# Generate with:  php artisan key:generate --show   (do NOT reuse the key from your local .env)
APP_KEY=
# Your live address, for example https://medtech-distributions.vercel.app
APP_URL=
APP_TIMEZONE=Africa/Lagos

# Supabase > Project Settings > Database > Connection string > "Session pooler"
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.fjmaadsvjbwfrgmxhnwf
DB_PASSWORD=
DB_SSLMODE=require

# Supabase > Storage > create a PUBLIC bucket (for example "media"), then Storage > S3 Connection > New access key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=media
AWS_ENDPOINT=https://fjmaadsvjbwfrgmxhnwf.supabase.co/storage/v1/s3
AWS_URL=https://fjmaadsvjbwfrgmxhnwf.supabase.co/storage/v1/object/public/media
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="MedTech Distributions"

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

COMPANY_NAME="MedTech Distributions Ltd"
DEFAULT_CURRENCY=NGN
VAT_RATE=0
